    "LocalMCP ermöglicht verbundenen KI- und MCP-Clients den Zugriff auf deine Daten. Je nach erteilten Freigaben, aktivierten Werkzeugen und ausgeführten Kurzbefehlen können Daten gelesen, weitergegeben, erstellt, verändert, überschrieben oder gelöscht werden.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LocalMCP ermöglicht verbundenen KI- und MCP-Clients den Zugriff auf deine Daten. Je nach erteilten Freigaben, aktivierten Werkzeugen und ausgeführten Kurzbefehlen können Daten gelesen, weitergegeben, erstellt, verändert, überschrieben oder gelöscht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LocalMCP gives connected AI and MCP clients access to your data. Depending on granted permissions, enabled tools and executed shortcuts, data may be read, shared, created, changed, overwritten or deleted."
          }
        }
      }
    },
    "LocalMCP FÜR MAC": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LocalMCP FÜR MAC"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LocalMCP FOR MAC"
          }
        }
      }
