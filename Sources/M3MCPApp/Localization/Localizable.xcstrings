    "1. Konfiguration inklusive Token kopieren.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Konfiguration inklusive Token kopieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Copy the configuration including the token."
          }
        }
      }
    },
    "1. Konfiguration mit dem Knopf unten kopieren.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Konfiguration mit dem Knopf unten kopieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Copy the configuration using the button below."
          }
        }
      }
    },
    "2. Den Eintrag m3mcp in den mcpServers-Bereich deines Clients übernehmen. Vorhandene andere Server beibehalten.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Den Eintrag m3mcp in den mcpServers-Bereich deines Clients übernehmen. Vorhandene andere Server beibehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Add the m3mcp entry to your client's mcpServers section. Keep any other existing servers."
          }
        }
      }
    },
    "2. In ~/.codex/config.toml den LocalMCP-Abschnitt ergänzen oder den vorhandenen LocalMCP-Eintrag ersetzen. Andere Server beibehalten.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2. In ~/.codex/config.toml den LocalMCP-Abschnitt ergänzen oder den vorhandenen LocalMCP-Eintrag ersetzen. Andere Server beibehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Add the LocalMCP section to ~/.codex/config.toml or replace the existing LocalMCP entry. Keep other servers."
          }
        }
      }
    },
    "2. Token und Client verbinden": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Token und Client verbinden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Connect token and client"
          }
        }
      }
    },
    "3. Die MCP-Verbindung im Client neu laden; falls nötig, den Client neu starten.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Die MCP-Verbindung im Client neu laden; falls nötig, den Client neu starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Reload the MCP connection in your client; restart the client if necessary."
          }
        }
      }
    },
    "3. Speichern und die MCP-Verbindung neu laden.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Speichern und die MCP-Verbindung neu laden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Save and reload the MCP connection."
          }
        }
      }
    },
