    "Apple Intelligence is not active for this process. Enable it in System Settings → Apple Intelligence & Siri. If it is already enabled, check that the Siri language matches the system language — a mismatch reports this same state.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ist für diesen Prozess nicht aktiv. Aktiviere es unter Systemeinstellungen → Apple Intelligence & Siri. Wenn es bereits aktiviert ist, prüfe, ob die Siri-Sprache mit der Systemsprache übereinstimmt. Eine Abweichung führt zum gleichen Status."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence is not active for this process. Enable it in System Settings → Apple Intelligence & Siri. If it is already enabled, check that the Siri language matches the system language — a mismatch reports this same state."
          }
        }
      }
    },
